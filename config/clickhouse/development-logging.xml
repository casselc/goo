<clickhouse>
    <!-- Disposable lab diagnostics; application OTLP tables are unaffected. -->
    <logger>
        <level>warning</level>
        <size>10M</size>
        <count>3</count>
    </logger>
    <text_log remove="1" />
    <trace_log remove="1" />
    <processors_profile_log remove="1" />
    <query_metric_log remove="1" />
    <query_views_log remove="1" />
    <latency_log remove="1" />
    <metric_log remove="1" />
    <asynchronous_metric_log remove="1" />
    <query_log><ttl>event_date + INTERVAL 1 DAY DELETE</ttl></query_log>
    <part_log><ttl>event_date + INTERVAL 1 DAY DELETE</ttl></part_log>
    <error_log><ttl>event_date + INTERVAL 1 DAY DELETE</ttl></error_log>
</clickhouse>
