{
  "name": "goo-journeys",
  "private": true,
  "scripts": {
    "test:journeys": "bash scripts/run_journeys.sh",
    "test:gotogether-shadow": "GOO_GOTOGETHER_SHADOW=1 playwright test journeys/first-use-acquisition.spec.js --workers=1",
    "model:check": "quint typecheck verification/model/lifecycle.qnt",
    "model:test": "quint run verification/model/lifecycle.qnt --main=lifecycleInstance --backend=typescript --max-samples=100 --max-steps=30 --invariant=safety --seed=42 --verbosity=1",
    "test:visualizations": "node --experimental-test-module-mocks --test tests/*.test.js tests/*.test.mjs",
    "test:bombadil": "bombadil browser test --headless --time-limit 1m --exit-on-violation http://localhost:8088 verification/bombadil/workspace.ts",
    "test:cross-app": "playwright test journeys/cross-app.spec.js",
    "test:generated-campaign": "GOO_GENERATED_CAMPAIGN=1 playwright test journeys/generated-campaign.spec.js",
    "test:campaign-adapters": "node --test tests/bombadil-adapter.test.js",
    "test:fault-campaign": "GOO_FAULT_CAMPAIGN=1 bash scripts/run_journeys.sh --reservation journeys/fault-campaign.spec.js",
    "test:bombadil:inspection": "bombadil browser test --headless --time-limit 30s --exit-on-violation http://localhost:8088 verification/bombadil/inspection.ts",
    "test:discovery-campaign": "GOO_DISCOVERY_QUINT=1 GOO_DISCOVERY_BOMBADIL=1 playwright test journeys/discovery.spec.js",
    "test:inventory-campaign": "GOO_INVENTORY_BOMBADIL=1 playwright test journeys/inventory.spec.js",
    "test:captures-campaign": "GOO_CAPTURES_BOMBADIL=1 playwright test journeys/captures.spec.js",
    "test:core-campaign": "GOO_CORE_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/core-basics.spec.js",
    "test:grouped-campaign": "GOO_GROUPS_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/grouped-measures.spec.js",
    "test:error-comparison-campaign": "GOO_ERROR_COMPARISON_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/error-comparison.spec.js",
    "test:context-campaign": "GOO_CONTEXT_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/context-notes.spec.js",
    "test:recipes-campaign": "GOO_RECIPES_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/recipes.spec.js",
    "test:measurements-campaign": "GOO_MEASUREMENTS_BOMBADIL=1 bash scripts/run_journeys.sh --reservation journeys/measurements.spec.js",
    "test:smoke": "bash scripts/run_journeys.sh --reservation --smoke",
    "diagnostics:plan": "python3 scripts/retain_diagnostics.py",
    "diagnostics:prune": "python3 scripts/retain_diagnostics.py --apply",
    "test:gotogether-controls": "cd verification/gotogether && go tool gotogether tangle -check model/acquisition.md design/paired-filters.md && GOTOGETHER_STRICT=1 QUINT_BACKEND=typescript go test -mod=readonly -count=1 -run \"^(TestModelPossible|TestProtocolControls|TestCW1Fixture|TestLiterate.*|TestPairedFilter.*)$\" .",
    "test:journeys:reservation": "bash scripts/run_journeys.sh --reservation"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.7.9",
    "@informalsystems/quint": "0.33.1",
    "@playwright/test": "1.56.1"
  }
}
